# Required: Relay API and managed tunnel domains
# Production adopts retained DNS zones in your Cloudflare account. The API
# zone serves relay.<zone> in production and relay-<stage>.<zone> for personal
# stages. Managed environment endpoints are provisioned below the tunnel zone.
RELAY_API_ZONE_NAME=example.com
RELAY_TUNNEL_ZONE_NAME=tunnels.example.com

# Optional: Relay domain override
# Set this only when the derived relay hostname should not be used.
# RELAY_DOMAIN=relay.example.com

# Required unless OIDC is configured below: Clerk
# Get the keys from the Clerk Dashboard under API keys. Set the JWT audience to
# the `aud` claim configured on the `t3-relay` JWT template.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_AUDIENCE=t3-code-relay

# Required unless Clerk is configured above: OIDC
# Trust an OIDC provider such as any standard OIDC-compliant IdP instead of Clerk.
# OIDC_JWKS_URL overrides the JWKS location discovered from the issuer's
# well-known configuration document; leave it unset to use discovery.
# OIDC_ISSUER_URL=https://issuer.example.com
# OIDC_AUDIENCES=t3-code-relay
# OIDC_JWKS_URL=https://issuer.example.com/.well-known/jwks.json

# Optional: PlanetScale sizing overrides for self-hosted deployments. Defaults
# match the checked-in values (PS_20, us-west, 2 replicas). Set replicas to 0
# to omit read replicas on plans that do not include them.
# RELAY_DATABASE_CLUSTER_SIZE=PS_20
# RELAY_DATABASE_REGION=us-west
# RELAY_DATABASE_REPLICAS=2

# Optional: Apple Push Notification service
# Required only for mobile push notifications and Live Activities; the relay
# runs without them and skips push delivery until they are added. Get these
# values from your Apple Developer account. Use `sandbox` for development
# APNs credentials and `production` for production credentials. These five
# variables are all-or-nothing: set every one of them, or leave every one
# unset.
# APNS_ENVIRONMENT=sandbox
# APNS_TEAM_ID=...
# APNS_KEY_ID=...
# APNS_BUNDLE_ID=...
# APNS_PRIVATE_KEY=...

# Optional: Axiom request tracing
# Required only for request tracing; the relay deploys and runs without it
# and skips creating tracing resources and exporting spans until it is added.
# AXIOM_TOKEN alone authenticates with an org-scoped Axiom API token.
# AXIOM_ORG_ID is required only alongside a personal access token; set it
# together with AXIOM_TOKEN, or leave both unset.
# AXIOM_TOKEN=...
# AXIOM_ORG_ID=...
